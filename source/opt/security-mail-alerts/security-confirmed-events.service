[Unit]
Description=Confirmed user violation evidence watcher
After=security-bt-quarantine.service
Requires=security-bt-quarantine.service

[Service]
ExecStart=/usr/bin/python3 /opt/security-mail-alerts/confirmed_watcher.py
Restart=on-failure
RestartSec=3
User=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=security-mail-alerts
StateDirectoryMode=0700
ReadWritePaths=/var/lib/security-mail-alerts
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=96M

[Install]
WantedBy=multi-user.target
